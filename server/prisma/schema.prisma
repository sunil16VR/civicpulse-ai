generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String      @id @default(uuid())
  name              String
  email             String      @unique
  passwordHash      String
  role              String      // CITIZEN, OFFICER, DEPARTMENT_HEAD, ADMIN
  departmentId      String?
  phone             String?
  preferredLanguage String      @default("en") // en, ta
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  department        Department? @relation("DepartmentMembers", fields: [departmentId], references: [id])
  complaints        Complaint[] @relation("CitizenComplaints")
  assignedComplaints Complaint[] @relation("OfficerComplaints")
}

model Department {
  id                String      @id @default(uuid())
  name              String      @unique
  categoriesHandled String      // JSON array of strings: e.g. ["Streetlight/Electrical"]
  headId            String?
  createdAt         DateTime    @default(now())

  users             User[]      @relation("DepartmentMembers")
  complaints        Complaint[]
  incidents         Incident[]
}

model Complaint {
  id                    String      @id @default(uuid())
  displayId             String      @unique // e.g. CP-2026-0001
  title                 String
  description           String
  originalLanguage      String      @default("en") // en, ta
  translatedDescription String?
  category              String
  lat                   Float
  lng                   Float
  addressText           String
  images                String      @default("[]") // JSON string array of URLs
  citizenId             String
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  // AI & Priority Fields
  severity              String      @default("Medium") // Low, Medium, High, Critical
  safetyImpact          String      @default("Medium") // Low, Medium, High, Critical
  publicImpact          String      @default("Medium") // Low, Medium, High, Critical
  affectedPeople        Int         @default(1)
  durationDays          Int         @default(1)
  priorityScore         Int         @default(50) // 0-100
  priorityReasons       String      @default("[]") // JSON string array of reason strings

  // Assignment & Routing
  departmentId          String?
  assignedOfficerId     String?
  incidentId            String?

  // SLA & Predictive Risk
  slaHours              Int         @default(72)
  slaDeadline           DateTime
  slaRisk               String      @default("Low") // Low, Medium, High
  slaRiskReason         String?

  // Workflow State
  status                String      @default("Submitted") // Submitted, AI_Analyzed, Assigned, In_Progress, Resolution_Submitted, Verified, Resolved, Reopened
  isDuplicate           Boolean     @default(false)
  aiOverridden          Boolean     @default(false)

  // Relations
  citizen               User        @relation("CitizenComplaints", fields: [citizenId], references: [id])
  assignedOfficer       User?       @relation("OfficerComplaints", fields: [assignedOfficerId], references: [id])
  department            Department? @relation(fields: [departmentId], references: [id])
  incident              Incident?   @relation(fields: [incidentId], references: [id])
  
  statusHistory         StatusHistory[]
  resolution            Resolution?
  feedback              Feedback?
  overrideLogs          OverrideLog[]
}

model Incident {
  id            String      @id @default(uuid())
  title         String
  category      String
  centroidLat   Float
  centroidLng   Float
  complaintCount Int        @default(1)
  priorityScore Int         @default(50)
  departmentId  String?
  status        String      @default("Active") // Active, In_Progress, Resolved
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  department    Department? @relation(fields: [departmentId], references: [id])
  complaints    Complaint[]
}

model StatusHistory {
  id          String    @id @default(uuid())
  complaintId String
  status      String
  changedBy   String    // User name/role or System
  timestamp   DateTime  @default(now())
  note        String?

  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
}

model Resolution {
  id               String    @id @default(uuid())
  complaintId      String    @unique
  officerId        String
  description      String
  proofImages      String    @default("[]") // JSON string array
  submittedAt      DateTime  @default(now())
  verifiedBy       String?
  verifiedAt       DateTime?
  verificationNote String?
  rejected         Boolean   @default(false)

  complaint        Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
}

model Feedback {
  id                    String    @id @default(uuid())
  complaintId           String    @unique
  rating                Int       // 1-5
  comment               String?
  citizenConfirmedResolved Boolean @default(true)
  createdAt             DateTime  @default(now())

  complaint             Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
}

model OverrideLog {
  id          String   @id @default(uuid())
  complaintId String
  adminId     String
  field       String
  oldValue    String
  newValue    String
  reason      String
  timestamp   DateTime @default(now())

  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
}

model Insight {
  id        String   @id @default(uuid())
  text      String
  type      String   // Trend, Hotspot, Bottleneck, Category
  createdAt DateTime @default(now())
}
